var
  lJSon : string;
begin
  lJSon := '{"CodArt":"'+ vCodart+'", "DescArt":"'+ vDescArt+'","Lote":"'+ vLote+'","Peso":"'+FormateaFloatSQL(vPeso)+
           '","FechaPesada":"'+ vFecha+'"}';


  with sqlConsulta do
  begin
    close;
