       result := False;

  end;
end;

function TdmdDatos.ValidarDatos(vCodart, vLote, vEtiqueta: string): boolean;
begin
  result := true;
  if vCodArt = '' then
  begin
     MessageDlg('Debe indicar un articulo', mtError, [mbOk], 0);
     Result := False;
     exit;
  end;
  if vEtiqueta = '' then
  begin
     MessageDlg('Debe indicar una etiqueta', mtError, [mbOk], 0);
     Result := False;
     exit;
  end;
  if ((UsaLotes(vCodArt)) and (vLote = '')) then
  begin
     MessageDlg('Debe indicar un lote', mtError, [mbOk], 0);
     Result := False;
  end;


end;

