end;

procedure TdmdDatos.BuscaLecturas(vTipo:integer; vLote:string);
var
  lCadena : string;
begin
  with sqlLecturas do
  begin
    close;
    sql.Clear;

    sql.Add('Select ge_id, ge_codart, ge_descripcion, ge_fecha, ge_lote, ge_peso, ge_usuario, ge_Json, ge_etiqueta, ge_idregu, ge_impresa');
    sql.Add('from ge_pesadas with(nolock)');
    sql.Add('where 1 = 1');
    sql.Add('and ge_lote = '+ quotedstr(vLote));
    if vTipo = 0 then
       sql.Add('and coalesce(ge_idregu, 0) = 0');
    if vTipo = 1 then
       sql.Add('and coalesce(ge_impresa,''F'') = ''F''');

    if vTipo = 2 then
    begin
       sql.Add('and coalesce(ge_idregu, 0) = 0');
       sql.Add('and coalesce(ge_impresa,''F'') = ''F''');
    end;
    lcadena := sql.text;
    open;
  end;
end;

function TdmdDatos.BuscarEtiqueta(vCodigo: string; var vEtiqueta,
  vDescEtiqueta: string): string;
begin
    with sqlConsulta do
  begin
    close;
    sql.Clear;

    sql.Add('Select ge_id, ge_codigo, coalesce(ge_etiqueta,'''') etiqueta, coalesce(ge_descripcion,'''') descripcion ');
    sql.Add('from ge_etiquetas with(nolock)');
    sql.Add('where ge_codigo = ' + quotedstr(cuadrasiesnumerico(vCodigo,8)));
    open;

    vEtiqueta := fieldbyname('Etiqueta').AsString;
    vDescEtiqueta := fieldByName('Descripcion').AsString;
    result := fieldByName('ge_codigo').AsString;
  end;
end;

