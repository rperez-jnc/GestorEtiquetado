procedure TdmdDatos.LeeIni(vIni: TIniFile);
begin
  inherited;
  FicheroIni := vIni.FileName;
  Empresa := vIni.ReadString('Datos','Empresa','');
  NombreArchivoLog := vIni.ReadString(GrupoDatosIni, 'NombreArchivoLog', '');
  Timer := stringtoint(vIni.ReadString('Opciones','Timer','500'));
  Bascula :=stringtoint(vIni.ReadString('Opciones','Bascula',''));
  Descarte := Stringtofloat(vIni.ReadString('Opciones', 'Descarte', '0'));
  Almacen := cuadrasiesnumerico(vIni.ReadString('Opciones', 'Almacen', '2'),8);
  ImpresionAutomatica := vIni.ReadString('Opciones','ImpresionAutomatica','T') = 'T';
  ParamCodCli :=vIni.ReadString('Opciones','ParamCodCli','');
  ParamLote := vIni.ReadString('Opciones','ParamLote','');
  ParamId := Stringtoint(vIni.ReadString('Opciones','ParamId','0') );
  ImpresoraEtiArt := vIni.ReadString('Opciones','ImpresoraEtiArt','');


end;

