procedure TdmdDatos.MarcaLineaRegu(vId, vIdRegu, vNumLin: double);
begin
   with sqlConsulta do
  begin
    close;
    sql.Clear;

    sql.Add('Update ge_pesadas set ge_idregu = ' + formateafloatsql(vIdRegu));
    sql.Add(', ge_numlinreg = ' + formateafloatsql(vNumLin));
    sql.Add('where ge_id = ' + formateafloatsql(vId));

    execsql;
  end;
end;

procedure TdmdDatos.MarcaLineaImp(vId: double);
begin
  with sqlConsulta do
  begin
    close;
    sql.Clear;

    sql.Add('Update ge_pesadas set ge_impresa = ''T''');
    sql.Add('where ge_id = ' + formateafloatsql(vId));

    execsql;
  end;
end;

procedure TdmdDatos.MarcarLineasImp;
begin
  with jvmLineasMarcar do
   begin
     first;
     while not eof do
     begin

       MarcaLineaImp(fieldbyname('Id').AsFloat);

       next;
     end;
   end;
end;

procedure TdmdDatos.MarcarLineasRegu(vIdRegu: double);
var
  lId, lNumLin:double;

begin

   with jvmPesosPorLinea do
   begin
     first;
     while not eof do
     begin
       lId :=  fieldbyname('Id').AsFloat;
       lNumLin := fieldbyname('NUmLin').AsFloat;
       MarcaLineaRegu(lId, vIdRegu,lNumLin);

       next;
     end;
   end;
end;

