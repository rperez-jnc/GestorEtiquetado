    if recordcount > 0 then
    begin
       result := vClave = fieldbyname('ge_clave').AsString;
       UsuarioLog := vUsuario;
       Persona:= trim(fieldbyname('codper').AsString)  + ' - ' + trim(fieldbyname('nomper').AsString) ;
    end
