procedure TFrmPrincipal.btnImprimirClick(Sender: TObject);
var
  li:integer;
  lcodart, lEtiqueta,lFormato : string;
  lPeso, lId: double;
begin
   //Imprimimos las etiquetas de todos los articulos seleccinados

    with FraCxGridPesadas.dbtvDatos.Controller do
    begin
         // Si no hay registros marcados, salta un aviso y no hace nada.
        if SelectedRecordCount = 0 then
        begin
          MessageDlg('Seleccione una o más pesadas', mtInformation, [mbOK], 0);
          Screen.Cursor := crDefault;
          exit;
        end;
        bd.JvmLineasMarcar.Close;
        bd.JvmLineasMarcar.Open;

        try
            for lI := 0 to SelectedRecordCount - 1 do
            begin
               Screen.Cursor := crHourGlass;
               lCodArt := TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_Codart');
               lEtiqueta := TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_Etiqueta');
               lId := TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_Id');
               lFormato := Bd.BuscarFormatoEtiqueta(lEtiqueta);
               CargaSqlEtiquetas(FraCliente.edCodigo.Text);
               Bd.ImprimirEtiqueta(lCodArt,lFormato,FraCliente.edCodigo.Text, EdLote.Text, lId);
               bd.JvmLineasMarcar.Appendrecord([lId]);
               Screen.Cursor := crDefault;
            end;
        finally
           bd.MarcarLineasImp;
           bd.JvmLineasMarcar.Close;
           bd.JvmLineasMarcar.Open;
           CargaLecturas(cbOpciones.ItemIndex, edlote.Text);
        end;
    end;

end;

procedure TFrmPrincipal.btnIniciarClick(Sender: TObject);
begin
  if bd.ValidarDatos(FraArticulo.edCodigo.text, edLote.text, edCodigoEtiqueta.Text) then
  begin
     if btnIniciar.Caption = KIniPeso  then
     begin
        Bascula := TaccesoBascula.Create(self, tmPeso,bd.Descarte);

        Bascula.TipoPeso := 'Baxtran';
        edPeso.Text := '';

         // Bascula inactiva
        Bascula.Estado := teInactivo;

        activaTimerPeso(false);

        activaTimerPeso(not(Bascula.Estado = teInactivo));
        Bascula.InicializaPesos;

        btnIniciar.Caption := kFinPeso;
        Bascula.abrePuerto;
         if Bascula.Estado = teInactivo then
           btnIniciar.Caption := kIniPeso;
        activaTimerPeso( Bascula.Estado <> teInactivo);
        //Desactivamos el resto de campos para que no se puedan modificar mientras pesamos
        Panel1.Enabled := False;
        edlote.ReadOnly := true;
        btnSelecTodo.enabled := False;
        btnDeselecTodo.enabled := False;
        BtnSalir.Enabled := False;
        btnImprimir.Enabled := False;
        BtnRegularizar.Enabled := False;
        chkImpresion.Enabled := False;
     end
     else
     begin
        btnIniciar.Caption := KIniPeso;
        Bascula.destroy;
        lblEstadoBascula.Caption := 'Inactivo';
        Panel1.Enabled := True;
        edlote.ReadOnly := False;

        btnSelecTodo.enabled := True;
        btnDeselecTodo.enabled := True;
        BtnSalir.Enabled := True;
        btnImprimir.Enabled := True;
        BtnRegularizar.Enabled := True;
        chkImpresion.Enabled := True;
     end;
  end;
end;

procedure TFrmPrincipal.btnRegularizarClick(Sender: TObject);
var
  li: integer;
  lCodart:string;
  lpeso, lid :double;
  llote: string;
  lIdReg:double;
  lCodartAnt: string;
  lUnidades:double;
  lNUmLin : double;
  lListPesos : TStringList;
begin
  lListPesos := TStringList.Create;
  lListPesos.Delimiter := ',';
  //Imprimimos las etiquetas de todos los articulos seleccinados

    with FraCxGridPesadas.dbtvDatos.Controller do
    begin
         // Si no hay registros marcados, salta un aviso y no hace nada.
        if SelectedRecordCount = 0 then
        begin
          MessageDlg('Seleccione una o más pesadas', mtInformation, [mbOK], 0);
          Screen.Cursor := crDefault;
          exit;
        end;


        bd.JvmLineasARegularizar.close;
        bd.JvmLineasARegularizar.open;


        lLote := edLote.Text;
        if not bd.BuscarRegularizacion(lLote) then
        begin
          MessageDlg('No se encontró ninguna regularización para ese lote', mtError, [mbOK], 0);
          exit;
        end;
        try
          try
              for lI := 0 to SelectedRecordCount - 1 do
              begin
                 Screen.Cursor := crHourGlass;
                 lId :=  TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_id');
                 //Metemos las lineas en un memorydata para ordernarlas por codigo de articulo
                 bd.JvmLineasARegularizar.AppendRecord([Uppercase(TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_Codart')),
                                                        TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_descripcion'),
                                                        TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_fecha'),
                                                        TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_lote'),
                                                        lId,
                                                        TJncGridDx.BuscaValor(FraCxGridPesadas.dbtvDatos,FraCxGridPesadas.dbtvDatos.Controller.SelectedRecords[li].RecordIndex,'ge_peso')]);


              end;

              //Ahora ordenamos por codart para sumar cantidades y generar linea por codart

              with bd.JvmLineasARegularizar do
              begin
                 SortOnFields('Ge_CodArt',False,False);
                 first;

                 lCodArt := Fieldbyname('Ge_codart').AsString;
                 lCodArtAnt := lCodArt;
                 lPeso :=  Fieldbyname('ge_peso').AsFloat;
                 lId :=  FieldByName('ge_id').AsFloat;

                 lUnidades := 0;
                 while not eof do
                 begin
                   if lCodArt <> lCodArtAnt then
                   begin
                      Bd.CrearLineaRegularizacion(lCodArtAnt,lLote,lUnidades ,lListPesos);
                      lUnidades := lPeso;
                      lListPesos.Free;
                      lListPesos := TStringList.Create;
                      lListPesos.Delimiter := ',';
                      lListPesos.Add(FloatToStr(lId));

                   end
                   else
                   begin
                     lUnidades := lUnidades + lPeso;

                     lListPesos.Add(FloatToStr(lId));
                   end;


                   next;
                   lCodArtAnt := lCodArt;
                   lCodArt := Fieldbyname('Ge_codart').AsString;
                   lPeso :=  Fieldbyname('ge_peso').AsFloat;
                   lId :=  FieldByName('ge_id').AsFloat;


                 end;
                 //Creamos la ultima

                 Bd.CrearLineaRegularizacion(lCodArtAnt,lLote,lUnidades ,lListPesos);



              end;


                 Screen.Cursor := crDefault;
          finally
            lListPesos.Free;
            lIdReg := bd.FinalizarRegularizacion;
            if lIdReg > 0 then
            begin
              MessageDlg('Se ha modificado la regularizacion ' + Bd.NumeroRegularizacion(lIdReg), mtInformation, [mbOK], 0);
              Bd.MarcarLineasRegularizacion(lIdReg);
              CargaLecturas(cbOpciones.ItemIndex, edLote.Text);
            end;
          end;
        except
          on e:exception do
          begin
             MessageDlg('Error al crear la regularizacion ' + e.message, mtError, [mbOK], 0);
             bd.CancelaRegularizacion;
          end;

        end;

    end;

end;

