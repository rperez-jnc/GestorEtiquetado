        gFicheroIni := bd.FicheroIni;

   except
       on e: Exception do
       begin
           Showmessage(e.Message);
           Application.Terminate;
       end;

   end;
   if Not bd.ExisteBascula then
   begin

     Application.Terminate;
   end;

    Bd.InicializaNax;

   Show;
   FraArticulo.inicializa(gFicheroIni, edArticulo);
   FraCliente.inicializa(gFicheroIni, edCliente);
   dtFechaPesada.Date := Now();

   if not UsuarioValido then
     Application.Terminate;

   edUsuario.Text := bd.UsuarioLog;
   edPersona.Text := bd.Persona;
   Bd.Lote := '';
   Bd.Peso := 0;
   btnIniciar.Caption := kIniPeso;
   cbOpciones.ItemIndex := 0;
   chkImpresion.Checked := bd.ImpresionAutomatica;


end;

procedure TFrmPrincipal.FormKeyDown(Sender: TObject; var Key: Word;
  Shift: TShiftState);
begin

  if Key = VK_F11 then
  begin
    Key := 0; // consumir la tecla
    if FraArticulo.edCodigo.Focused then
        bd.EdicionDeArticulo(FraArticulo.edCodigo.Text);
  end
  else
  if Key = VK_F12 then
  begin
    Key := 0; // consumir la tecla
    if FraArticulo.edCodigo.Focused then
        FraArticulo.acBusquedaExecute(Sender)
    else
    if FraCliente.edCodigo.Focused then
        FraCliente.acBusquedaExecute(Sender)
    else
    if edCodigoEtiqueta.Focused then
         AcBuscaEtiquetaExecute(Sender);
  end

end;

